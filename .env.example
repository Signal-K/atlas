VITE_PB_URL=https://signal-k-starsailors.fly.dev
VITE_ATLAS_MEDIA_URL=

# Atlas billing service (Polar checkout + entitlement refresh), extracted
# out of the shared backend into its own Fly deploy -- see
# documentation/star-sailors-platform/08-backend-consolidation-audit.md,
# item 3. src/lib/pocketbase.ts's atlasBillingFetch() forwards this app's
# existing PocketBase auth token as a bearer token; atlas-billing verifies
# it against the shared backend rather than holding its own users collection.
VITE_ATLAS_BILLING_URL=https://signal-k-atlas-billing.fly.dev

# Public VAPID key for watchlist push notifications (AT-011). Generate the
# pair with `npm run vapid`; only the public half goes here/client-side.
VITE_VAPID_PUBLIC_KEY=

# PostHog analytics (Atlas MVP sprint). Leave blank to disable analytics
# entirely -- src/lib/analytics.ts no-ops without a key, so this is optional
# for local dev.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# Server-side/admin only. Never expose this as VITE_* or ship it to the
# browser; only use it from trusted scripts when creating or managing surveys.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=

# Server-side event capture (pocketbase/pb_hooks/polar.pb.js, scripts/notify.mjs).
# These run outside Vite, so they read plain POSTHOG_KEY/POSTHOG_HOST rather
# than the VITE_-prefixed client vars above -- reuse the same project key,
# it's a write-only capture key so it's fine to share across runtimes.
POSTHOG_KEY=
POSTHOG_HOST=

# PostHog Surveys API object IDs, populated by running
# `node scripts/posthog-surveys-setup.mjs` once with POSTHOG_PROJECT_ID and
# POSTHOG_PERSONAL_API_KEY set. Leave blank to keep FeedbackDock's existing
# custom event names (src/components/FeedbackDock.tsx) -- once set, survey
# submissions/dismissals attribute to the matching PostHog Survey object
# instead of firing bare custom events.
VITE_POSTHOG_NPS_SURVEY_ID=
VITE_POSTHOG_SURVEY_REMINDER_ID=
VITE_POSTHOG_SURVEY_TARGET_ID=

# Affiliate revenue (Atlas monetization strategy). Both are optional --
# leave blank to disable; src/lib/affiliate.ts renders no link at all when
# unset, rather than shipping a dead or unattributed link.
#
# Amazon Associates tag (search-deep-link, no ASIN catalog needed). Shown as
# "Shop tripods" only when a camera recipe calls for one.
VITE_AMAZON_ASSOCIATE_TAG=
#
# Tour/booking affiliate deep-link template with a `{query}` placeholder,
# e.g. a Viator/GetYourGuide affiliate search URL. Shown as "Find tours &
# stays nearby" on each dark-sky trip card once a real program is set up.
VITE_TOUR_AFFILIATE_BASE_URL=

# Polar.sh checkout link for the one-time "Atlas Sky Pass" fallback (product id
# 1bf30516-1449-4b67-8fdb-c5616d5d4232, org "Landnam Ventures"). Create the
# Checkout Link in the Polar dashboard (Products > Atlas Sky Pass > Checkout
# Links) and paste its https://buy.polar.sh/... URL here. Only used as a
# fallback if the dynamic checkout below fails (src/lib/entitlement.ts) --
# leave blank once that's confirmed working, to avoid a stray dead link.
VITE_POLAR_CHECKOUT_URL=

# Server-side Polar checkout (pocketbase/pb_hooks/polar-checkout.pb.js,
# hand-ported into atlas-billing/internal/extensions/polar.go). These live
# on the atlas-billing host, not the Atlas static site or the shared
# PocketBase backend -- Atlas itself has no server component (AT-012), and
# atlas-billing owns the whole Polar integration (checkout, entitlement
# refresh, and the order.paid webhook below) as its own deploy.
#
# Organization Access Token from the Polar dashboard (Settings > API Keys).
POLAR_ACCESS_TOKEN=
# Optional legacy override -- forces dynamic checkout to use exactly one
# product instead of the default multi-product checkout below.
POLAR_PRODUCT_ID=
# Optional multi-product override -- comma-separated Polar product IDs. Leave
# blank to use the production defaults in `polar-checkout.pb.js`:
# - Atlas Sky Pass Monthly, CHF 4/mo:
#   7e023cdd-0172-4312-b0b7-251281ba8d1e
# - Atlas Sky Pass Yearly, CHF 40/yr:
#   ad9d6d76-7994-497d-a624-8f7a5c7f68c3
# - Atlas Sky Pass Lifetime, CHF 55:
#   352cfa25-638e-4f6e-bbcf-00e4d4b12854
# - Legacy Atlas Sky Pass, CHF 5 one-time:
#   1bf30516-1449-4b67-8fdb-c5616d5d4232
POLAR_PRODUCT_IDS=
# Optional. Set false if you do not want normal users to type Polar discount
# codes at checkout. Hidden comped-email grants always apply their configured
# discount automatically and disable editable discount codes for that checkout.
POLAR_ALLOW_DISCOUNT_CODES=true
# Where Polar redirects the browser after a successful checkout.
# {CHECKOUT_ID} is replaced by Polar with the completed checkout's id.
POLAR_SUCCESS_URL=

# Clerk ("Star Sailors" shared ecosystem app, KES-189) is the sign-in/sign-up
# system -- AuthForm renders Clerk's widgets directly. Dev publishable key;
# run `clerk env pull` to populate .env.local, not committed here.
VITE_CLERK_PUBLISHABLE_KEY=
