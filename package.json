{
  "name": "atlas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run lint && npm run build && npm run test:e2e",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:writes": "E2E_WRITE_TESTS=1 playwright test e2e/atlas-account-journey.spec.ts",
    "e2e:purge": "node scripts/purge-atlas-e2e.mjs",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "stars": "node scripts/generate-bright-stars.mjs",
    "ingest": "node scripts/ingest.mjs",
    "notify": "node scripts/notify.mjs",
    "moderate": "node scripts/moderate-photo-challenges.mjs",
    "vapid": "node scripts/generate-vapid-keys.mjs",
    "posthog:surveys": "node scripts/posthog-surveys-setup.mjs",
    "capture:video": "node scripts/capture-mobile-video.mjs",
    "render:voice": "node scripts/render-demo-narration.mjs",
    "render:video": "node scripts/mux-demo-video.mjs"
  },
  "dependencies": {
    "astronomy-engine": "^2.1.19",
    "pocketbase": "^0.27.0",
    "posthog-js": "^1.399.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cypress": "^15.20.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
