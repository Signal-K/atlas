# Cache policy for the built app. Understood by Cloudflare Pages and Netlify;
# if Atlas moves to a plain nginx/Caddy origin these rules need porting there.
#
# Everything under /assets/ is content-hashed by Vite (index-CSyeqFcw.js etc),
# so a changed file always gets a new URL -- it can be cached forever. This is
# what makes splitting react/ and astronomy/ into their own chunks pay off:
# they survive app deploys in the browser cache instead of being re-fetched
# inside one big bundle every time.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry point is NOT hashed and must never be cached, or visitors keep
# booting an old build that points at deleted /assets/ URLs.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Same reasoning: the service worker and PWA manifest decide which build the
# user gets, so they have to be revalidated every load.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Unhashed icons under the site root -- long-lived but not immutable, since
# these keep their filenames across deploys.
/*.png
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
