{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "atlas-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "ATLAS_MEDIA",
      "bucket_name": "atlas-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ATLAS_MEDIA_QUOTA",
        "class_name": "AtlasMediaQuota"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AtlasMediaQuota"]
    }
  ],
  "vars": {
    "POCKETBASE_URL": "https://signal-k-starsailors.fly.dev",
    "ALLOWED_ORIGINS": "https://youratlas.cc,https://atlas-4xz.pages.dev,http://localhost:5173,http://127.0.0.1:5173",
    "R2_STORAGE_SOFT_LIMIT_BYTES": "8000000000",
    "R2_MONTHLY_UPLOAD_SOFT_LIMIT": "800000"
  }
}
